{
  "expo": {
    "name": "Barbería SaaS",
    "slug": "barberiasaas-mobile",
    "scheme": "barberiasaas",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barberiasaas.mobile"
    },
    "android": {
      "package": "com.barberiasaas.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite que Barbería SaaS acceda al contacto que selecciones para registrarlo como cliente."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aed50576-93e9-479c-b518-e005fbd49e91"
      }
    }
  }
}