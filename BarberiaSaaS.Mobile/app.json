{
  "expo": {
    "name": "Barbería SaaS",
    "slug": "barberiasaas-mobile",
    "scheme": "barberiasaas",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.barberiasaas.mobile"
    },
    "android": {
      "package": "com.barberiasaas.mobile",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Permite que Barbería SaaS acceda al contacto que selecciones para registrarlo como cliente."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aed50576-93e9-479c-b518-e005fbd49e91"
      }
    }
  }
}
